[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Margin" type="MarginContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 6

[node name="PointsLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "Punkty: 0  ·  Seria: 0 dni"

[node name="HintLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
text = "WASD — ruch · PPM+mysz — kamera · E — rozmowa"

[node name="RewardToast" type="Label" parent="Margin/VBox"]
layout_mode = 2
modulate = Color(1, 0.92, 0.55, 1)
text = ""

[node name="Disclaimer" type="Label" parent="Margin/VBox"]
layout_mode = 2
modulate = Color(0.85, 0.85, 0.9, 1)
text = "Trening wspomagający — nie diagnostyka."
